# ================================================================
# 🤖 PROVERSE TELEGRAM BOT VA TIZIM SOZLAMALARI
# Barcha muhim sozlamalar (token, login, parol, API) shu yerda!
# ================================================================

# 1. TELEGRAM BOT SOZLAMALARI
# @BotFather orqali olingan bot tokeni
TELEGRAM_BOT_TOKEN="8531122232:AAGdZnwFRxfvHXV81FILvRr1cgnjj8uP7lA"

# Administratorlarning Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_TELEGRAM_IDS=767118452


# 2. PROVERSE SAYTI BILAN INTEGRATSIYA SOZLAMALARI
# Sayt manzili (masalan: https://proverse.uz yoki http://localhost:8000)
PROVERSE_BASE_URL=https://app.proverse.uz

# Ulanish usuli: "api" yoki "browser"
# "api"     -> Agar saytda REST API bo'lsa, to'g'ridan-to'g'ri API orqali ishlaydi (juda tez)
# "browser" -> Agar API bo'lmasa, orqa fonda brauzer (Playwright) orqali kirib belgilaydi
PROVERSE_AUTH_MODE=browser

# Agar PROVERSE_AUTH_MODE=api bo'lsa, API kaliti (Token)
PROVERSE_API_KEY=your_api_key_or_bearer_token_here

# Agar PROVERSE_AUTH_MODE=browser bo'lsa, ProVerse Admin Login va Paroli
PROVERSE_USERNAME=aslbek@proverse.uz
PROVERSE_PASSWORD=your_secure_password_here

# Brauzer rejimi sozlamalari (true bo'lsa orqa fonda ko'rinmasdan ishlaydi, false bo'lsa oyna ochiladi)
PLAYWRIGHT_HEADLESS=true


# 3. HISOBOT VA REJALASHTIRISH SOZLAMALARI
# Dushanba, Chorshanba, Juma kunlari soat 05:00 da (Cron formatida: Daqiqa Soat * * HaftaKunlari)
# 1 = Dushanba, 3 = Chorshanba, 5 = Juma
REPORT_CRON_SCHEDULE="0 5 * * 1,3,5"

# Hisobot qaysi vaqt mintaqasida ishlashi (O'zbekiston: Asia/Tashkent)
TIMEZONE=Asia/Tashkent
